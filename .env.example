# ---------------------------------------------------------------------------
# Local development environment. Copy to `.env` (gitignored) and adjust.
#
# In production every one of these is set in the Render dashboard instead, and
# nothing here is ever committed. `.github/workflows/ci.yml` greps for
# credential-looking values in tracked files, so a real secret pushed by mistake
# fails the build — and because git keeps history, a leaked value must be
# ROTATED, not merely deleted.
# ---------------------------------------------------------------------------

# ---- databases (docker-compose.yml) ----
DB_URL=jdbc:postgresql://localhost:5432/productdb
DB_USERNAME=shopease
DB_PASSWORD=shopease

# ---- auth ----
# MUST be at least 32 bytes — HS256 requires 256 bits of key material.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes!!
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=shopease-auth-service
# The bootstrap admin. Override this in any shared environment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- product images ----
# local = ./uploads served at /uploads/**   (no cloud account needed)
# s3    = upload to an S3 bucket            (production)
STORAGE_TYPE=local
UPLOAD_MAX_BYTES=5242880

# For STORAGE_TYPE=s3. Leave the keys blank to use the default AWS credentials
# chain (instance role, task role, ~/.aws/credentials) — which is what you want
# in production, because there is no long-lived key to leak.
# S3_BUCKET=shopease-product-images
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PATH_STYLE_ACCESS=false
# S3_PUBLIC_BASE_URL=https://shopease-product-images.s3.ap-south-1.amazonaws.com/

# ---- service addresses ----
EUREKA_URL=http://localhost:8761/eureka
PRODUCT_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
AUTH_SERVICE_URL=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- frontend ----
# .env.local in frontend/. Use /api to go through the Vite dev proxy.
VITE_API_URL=/api
